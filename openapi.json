    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A player token, an operator token, or an API key (mcmesh_sk_...) where the route says so."
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],

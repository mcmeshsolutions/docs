{
  "openapi": "3.1.0",
  "info": {
    "title": "mcmesh gateway API",
    "version": "1",
    "description": "Operator and tool facing routes. The host protocol (leases, WAL, blob upload) is described in board/PROTOCOL.md. Request and response bodies are documented there, per route; this file lists every route with its method, authorisation and path parameters so tools and tests can tell what exists."
  },
